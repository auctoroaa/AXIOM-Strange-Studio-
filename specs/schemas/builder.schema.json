{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strangestudio.ai/schemas/builder.schema.json",
  "title": "Builder",
  "type": "object",
  "required": [
    "id",
    "name",
    "role",
    "state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "role": {
      "enum": [
        "research",
        "design",
        "coding",
        "reasoning",
        "verification",
        "delivery",
        "orchestration"
      ]
    },
    "brain": {
      "type": "string"
    },
    "toolbox": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "currentBlueprint": {
      "type": "string"
    },
    "state": {
      "$ref": "./state.schema.json"
    },
    "memoryLinks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": "string"
    }
  }
}

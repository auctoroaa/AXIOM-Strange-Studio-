{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strangestudio.ai/schemas/truth.schema.json",
  "title": "Truth",
  "type": "object",
  "required": [
    "classification",
    "confidence"
  ],
  "properties": {
    "classification": {
      "enum": [
        "fact",
        "assumption",
        "prediction",
        "simulation",
        "hypothesis"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "verified": {
      "type": "boolean"
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "lastValidated": {
      "type": "string",
      "format": "date-time"
    }
  }
}

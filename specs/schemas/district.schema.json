{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strangestudio.ai/schemas/district.schema.json",
  "title": "District",
  "type": "object",
  "required": [
    "id",
    "name",
    "purpose"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "enum": [
        "observatory",
        "memory_city",
        "workshop_district",
        "intelligence_railway",
        "transparent_machine",
        "delivery_harbor",
        "creative_village"
      ]
    },
    "purpose": {
      "type": "string"
    },
    "structures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "builders": {
      "type": "array",
      "items": {
        "$ref": "./builder.schema.json"
      }
    }
  }
}

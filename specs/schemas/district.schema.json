{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Strange Studio District",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "purpose",
    "status",
    "contains"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{2,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 2
    },
    "purpose": {
      "type": "string",
      "minLength": 5
    },
    "status": {
      "enum": [
        "proposed",
        "implemented",
        "verified",
        "deprecated"
      ]
    },
    "contains": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "truthStatus": {
      "enum": [
        "fact",
        "assumption",
        "simulation",
        "unknown"
      ]
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strange.studio/schemas/architecture-pack.schema.json",
  "title": "Architecture Pack Manifest",
  "description": "Structural contract only. Semantic and runtime claims require separate evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "identity",
    "philosophy",
    "economy",
    "ontology",
    "reverseMappings",
    "stateMappings",
    "truthMappings",
    "districts",
    "questTypes",
    "workflowTemplates",
    "events",
    "dynamicEvents",
    "validation",
    "crossFieldValidation",
    "progression",
    "learningObjectives",
    "outputs",
    "compatibility",
    "successCondition",
    "masterLoop"
  ],
  "properties": {
    "apiVersion": {
      "type": "string",
      "minLength": 1
    },
    "kind": {
      "const": "ArchitecturePack"
    },
    "metadata": {
      "$ref": "#/$defs/metadata"
    },
    "identity": {
      "$ref": "#/$defs/identity"
    },
    "philosophy": {
      "$ref": "#/$defs/philosophy"
    },
    "economy": {
      "$ref": "#/$defs/economy"
    },
    "ontology": {
      "$ref": "#/$defs/ontology"
    },
    "reverseMappings": {
      "type": "object",
      "minProperties": 1
    },
    "stateMappings": {
      "type": "object",
      "minProperties": 1
    },
    "truthMappings": {
      "type": "object",
      "minProperties": 1
    },
    "districts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/district"
      }
    },
    "questTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "workflow"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "workflow": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "workflowTemplates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/workflowTemplate"
      }
    },
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/event"
      }
    },
    "dynamicEvents": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/dynamicEvent"
      }
    },
    "validation": {
      "type": "object"
    },
    "crossFieldValidation": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CF(0[1-9]|1[0-2])$"
          },
          "name": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "required",
              "warning",
              "informational"
            ]
          }
        },
        "additionalProperties": true
      }
    },
    "progression": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "unlocks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": true
      }
    },
    "learningObjectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "outputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "compatibility": {
      "type": "object",
      "required": [
        "requires"
      ],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "supports": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "successCondition": {
      "type": "string",
      "minLength": 1
    },
    "masterLoop": {
      "type": "array",
      "minItems": 2,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "metadata": {
      "type": "object",
      "required": [
        "id",
        "name",
        "version"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)\\\\.(0|[1-9]\\\\d*)(-[0-9A-Za-z.-]+)?(\\\\+[0-9A-Za-z.-]+)?$"
        },
        "description": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "identity": {
      "type": "object",
      "required": [
        "product",
        "system",
        "packType"
      ],
      "properties": {
        "product": {
          "type": "string"
        },
        "system": {
          "const": "OIOS"
        },
        "packType": {
          "enum": [
            "civilization",
            "projection",
            "gameplay",
            "utility"
          ]
        },
        "category": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "philosophy": {
      "type": "object",
      "required": [
        "principles"
      ],
      "properties": {
        "motto": {
          "type": "string"
        },
        "principles": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "economy": {
      "type": "object",
      "required": [
        "primaryResources"
      ],
      "properties": {
        "primaryResources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "progressionResource": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "ontology": {
      "type": "object",
      "required": [
        "primitives"
      ],
      "properties": {
        "primitives": {
          "type": "object",
          "required": [
            "Agent",
            "Workflow",
            "Knowledge",
            "Tool",
            "Event",
            "Verification",
            "Context",
            "Unknown",
            "Delivery"
          ],
          "properties": {
            "Agent": {
              "type": "string",
              "minLength": 1
            },
            "Workflow": {
              "type": "string",
              "minLength": 1
            },
            "Knowledge": {
              "type": "string",
              "minLength": 1
            },
            "Tool": {
              "type": "string",
              "minLength": 1
            },
            "Event": {
              "type": "string",
              "minLength": 1
            },
            "Verification": {
              "type": "string",
              "minLength": 1
            },
            "Context": {
              "type": "string",
              "minLength": 1
            },
            "Unknown": {
              "type": "string",
              "minLength": 1
            },
            "Delivery": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": true
    },
    "district": {
      "type": "object",
      "required": [
        "id",
        "name"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "purpose": {
          "type": "string"
        },
        "primitive": {
          "type": "string"
        },
        "resources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "workflowTemplate": {
      "type": "object",
      "required": [
        "id",
        "stages"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "stages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "id"
            ],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "next": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "terminal": {
                "type": "boolean"
              },
              "requiresVerification": {
                "type": "boolean"
              }
            },
            "additionalProperties": true
          }
        }
      },
      "additionalProperties": true
    },
    "event": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "schema": {
          "type": "object"
        },
        "observable": {
          "type": "boolean"
        },
        "causes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "effects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "dynamicEvent": {
      "type": "object",
      "required": [
        "id",
        "trigger",
        "outcome"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "trigger": {
          "type": "string",
          "minLength": 1
        },
        "outcome": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    }
  }
}

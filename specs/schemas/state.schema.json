{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strangestudio.ai/schemas/state.schema.json",
  "title": "State",
  "type": "object",
  "required": [
    "name",
    "visual"
  ],
  "properties": {
    "name": {
      "enum": [
        "ready",
        "active",
        "waiting",
        "blocked",
        "retrying",
        "failed",
        "complete",
        "simulated",
        "unknown",
        "low_confidence"
      ]
    },
    "description": {
      "type": "string"
    },
    "visual": {
      "type": "object",
      "properties": {
        "color": {
          "type": "string"
        },
        "icon": {
          "type": "string"
        },
        "animation": {
          "type": "string"
        },
        "pattern": {
          "type": "string"
        }
      }
    },
    "truthLevel": {
      "enum": [
        "verified",
        "probable",
        "unverified",
        "simulated"
      ]
    }
  }
}

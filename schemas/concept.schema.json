{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strange-studio.invalid/schemas/concept.schema.json",
  "title": "Strange Studio Concept Record",
  "description": "Versioned CGE concept DNA. Structural validation does not prove factual truth, design quality, implementation, or runtime behavior.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "concept_id",
    "name",
    "purpose",
    "lifecycle",
    "seed",
    "meaning",
    "functions",
    "human_model",
    "observable",
    "truth",
    "causality",
    "space",
    "visual",
    "interaction",
    "state_machine",
    "world_integration",
    "verification"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "concept_id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{2,63}$" },
    "name": { "type": "string", "minLength": 2, "maxLength": 100 },
    "purpose": { "type": "string", "minLength": 10, "maxLength": 500 },
    "lifecycle": {
      "enum": ["draft", "synthesized", "needs-definition", "accepted", "implemented", "verified", "deprecated", "superseded"]
    },
    "seed": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "statement"],
      "properties": {
        "kind": { "enum": ["idea", "problem", "technology", "need", "workflow", "question", "observation", "goal"] },
        "statement": { "type": "string", "minLength": 3, "maxLength": 2000 },
        "source": { "type": ["string", "null"] },
        "constraints": { "type": "array", "items": { "type": "string" } }
      }
    },
    "meaning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_abstraction", "rationale"],
      "properties": {
        "core_abstraction": { "type": "string", "minLength": 2 },
        "rationale": { "type": "string", "minLength": 10 }
      }
    },
    "functions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 2 }
    },
    "human_model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["analogy", "rationale", "scores"],
      "properties": {
        "analogy": { "type": "string", "minLength": 2 },
        "rationale": { "type": "string", "minLength": 10 },
        "alternatives": { "type": "array", "items": { "type": "string" } },
        "scores": {
          "type": "object",
          "additionalProperties": false,
          "required": ["understandability", "observability", "scalability", "emotional_clarity"],
          "properties": {
            "understandability": { "type": "number", "minimum": 0, "maximum": 1 },
            "observability": { "type": "number", "minimum": 0, "maximum": 1 },
            "scalability": { "type": "number", "minimum": 0, "maximum": 1 },
            "emotional_clarity": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "observable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "behaviors", "events"],
      "properties": {
        "objects": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "behaviors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "events": { "type": "array", "items": { "type": "string" } }
      }
    },
    "truth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["classification", "source", "verification", "history"],
      "properties": {
        "classification": { "enum": ["fact", "assumption", "prediction", "simulation", "unknown"] },
        "source": { "type": ["string", "null"] },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "verification": { "enum": ["unverified", "pending", "passed", "failed", "not-applicable"] },
        "ownership": { "type": ["string", "null"] },
        "citations": { "type": "array", "items": { "type": "string" } },
        "history": { "type": "array", "items": { "type": "string" } }
      }
    },
    "causality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trigger", "dependencies", "outcome", "unknown_cause_policy"],
      "properties": {
        "trigger": { "type": "string", "minLength": 2 },
        "dependencies": { "type": "array", "items": { "type": "string" } },
        "outcome": { "type": "string", "minLength": 2 },
        "unknown_cause_policy": { "type": "string", "minLength": 5 }
      }
    },
    "space": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "world_location"],
      "properties": {
        "level": { "enum": ["object", "room", "building", "district", "system", "civilization", "world"] },
        "parent": { "type": ["string", "null"] },
        "world_location": { "type": "string", "minLength": 2 }
      }
    },
    "visual": {
      "type": "object",
      "additionalProperties": false,
      "required": ["geometry", "material", "lighting", "color", "motion", "iconography"],
      "properties": {
        "geometry": { "type": "string" },
        "material": { "type": "string" },
        "lighting": { "type": "string" },
        "color": { "type": "string" },
        "motion": { "type": "string" },
        "iconography": { "type": "array", "items": { "type": "string" } }
      }
    },
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["user_intent", "steps", "accessibility_notes"],
      "properties": {
        "user_intent": { "type": "string", "minLength": 3 },
        "steps": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "accessibility_notes": { "type": "string" }
      }
    },
    "state_machine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["states", "transitions", "terminal_states"],
      "properties": {
        "states": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["ready", "working", "waiting", "blocked", "failed", "retrying", "complete", "unknown", "simulated"] }
        },
        "transitions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["from", "to", "trigger"],
            "properties": {
              "from": { "type": "string" },
              "to": { "type": "string" },
              "trigger": { "type": "string", "minLength": 2 }
            }
          }
        },
        "terminal_states": { "type": "array", "items": { "type": "string" } }
      }
    },
    "world_integration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relationships", "duplicate_check"],
      "properties": {
        "relationships": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["type", "target"],
            "properties": {
              "type": { "enum": ["depends-on", "triggers", "contains", "produces", "verifies", "delivers-to", "related-to"] },
              "target": { "type": "string", "minLength": 2 }
            }
          }
        },
        "duplicate_check": { "enum": ["not-run", "clear", "possible-duplicate", "conflict-found"] }
      }
    },
    "verification": {
      "type": "object",
      "additionalProperties": false,
      "required": ["meaning", "truth", "causality", "inspection", "state", "world_fit"],
      "properties": {
        "meaning": { "$ref": "#/$defs/gate" },
        "truth": { "$ref": "#/$defs/gate" },
        "causality": { "$ref": "#/$defs/gate" },
        "inspection": { "$ref": "#/$defs/gate" },
        "state": { "$ref": "#/$defs/gate" },
        "world_fit": { "$ref": "#/$defs/gate" },
        "reviewed_by": { "type": ["string", "null"] },
        "review_notes": { "type": "array", "items": { "type": "string" } }
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["timestamp", "action"],
        "properties": {
          "timestamp": { "type": "string", "format": "date-time" },
          "action": { "type": "string" },
          "actor": { "type": ["string", "null"] },
          "notes": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reason"],
      "properties": {
        "status": { "enum": ["pass", "fail", "needs-evidence", "not-run"] },
        "reason": { "type": "string", "minLength": 3 },
        "evidence": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

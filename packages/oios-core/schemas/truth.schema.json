{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strange-studio.dev/schemas/truth.schema.json",
  "title": "Truth Classification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "classification",
    "basis"
  ],
  "properties": {
    "classification": {
      "enum": [
        "source-defined",
        "proposed",
        "implemented",
        "verified",
        "unresolved",
        "unknown"
      ]
    },
    "basis": {
      "type": "string",
      "minLength": 1
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": []
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://strange-studio.dev/schemas/agent.schema.json",
  "title": "OIOS Agent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "capabilities",
    "toolIds"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "toolIds": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    }
  }
}
